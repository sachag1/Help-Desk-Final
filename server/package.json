{
  "name": "helpdesk-server",
  "version": "1.0.0",
  "description": "Help Desk API: Express + TypeScript + MongoDB (tickets and admin authentication).",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/server/index.js",
    "dev": "tsc && node --env-file=.env --watch dist/server/index.js",
    "watch": "tsc -w",
    "seed:admin": "tsc && node --env-file=.env dist/scripts/seedAdmin.js",
    "test": "tsc && node tests/api.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mongodb": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3"
  }
}